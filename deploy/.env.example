# 复制为 .env 后按需修改；.env 不入库。
# 仅用于本地/演示：DB_*（root/readdue）与 RABBITMQ_*（guest/guest）都是默认口令，
# 生产部署前必须全部替换为强口令，并设置强随机 APP_JWT_SECRET。

# 构建镜像的基镜来源；国内网络可用 docker.m.daocloud.io，海外/CI 留空用 docker.io
IMAGE_REGISTRY=docker.io

# 必填：JWT 签名密钥（≥32 字节、随机、不可猜测）
# 生成示例：openssl rand -base64 48
# 说明：此值留空时 docker compose 会直接拒绝启动，避免用示例密钥上线。
APP_JWT_SECRET=

# 初始管理员（仅当库中没有任何 ADMIN 时创建一次；密码 >= 12 位）
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_PASSWORD=

# 数据库
DB_ROOT_PASSWORD=root
DB_USERNAME=readdue
DB_PASSWORD=readdue

# RabbitMQ（生产必须改，guest 只允许本机）
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# 宿主端口（仅管理端对宿主发布；后端只在容器网络内提供 8125）
FRONTEND_PORT=8080

# 邮件（可选；不填则仅站内信，Email 通道会失败）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@readdue.local



