# 复制为 .env 后按需修改；.env 不入库
# 仅用于本地/演示：下面 DB_* 的 root/readdue、RABBITMQ_* 的 guest 均为默认口令，生产部署前必须全部替换为强口令。
# 必填：JWT 签名密钥（≥32 字节随机串）
APP_JWT_SECRET=change-me-to-a-long-random-string

# 数据库
DB_ROOT_PASSWORD=root
DB_USERNAME=readdue
DB_PASSWORD=readdue

# 宿主端口
FRONTEND_PORT=8080
BACKEND_PORT=8125

# 邮件（可选；不填则仅站内信，Email 通道会失败）
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@readdue.local
